# Odoo MCP Remote Server - Environment Variables
# 
# This version supports DYNAMIC AUTHENTICATION via headers or request body.
# These environment variables are OPTIONAL and serve as fallbacks only.
# Supports both PASSWORD and API KEY authentication methods.

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Optional Fallback Odoo Configuration
# These are used ONLY when no credentials are provided in the request
# For production, it's recommended to NOT set these and require per-request auth

ODOO_URL=https://your-default-odoo.com
ODOO_DB=your_default_database
ODOO_USERNAME=your_default_username

# Authentication Method 1: Password (traditional)
ODOO_PASSWORD=your_default_password

# Authentication Method 2: API Key (recommended for security)
# ODOO_API_KEY=your_api_key_here

# Note: If both ODOO_PASSWORD and ODOO_API_KEY are set, API_KEY takes priority

# Optional Odoo Connection Settings
ODOO_TIMEOUT=30
ODOO_VERIFY_SSL=true

# Security Notes:
# - This server is designed for dynamic authentication
# - Each request should provide its own credentials via headers or body
# - Environment variables are fallbacks only
# - For multi-tenant deployments, do not set ODOO_* variables
# - Use HTTPS in production to protect credentials in transit
# - API Keys are more secure than passwords (can be revoked independently)
# - Generate API keys in Odoo: Settings > Users > Your User > Preferences > API Keys
