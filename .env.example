# Odoo MCP Server Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Odoo Connection
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=your_database_name
ODOO_USERNAME=your_username

# Authentication Method 1: Password (traditional)
ODOO_PASSWORD=your_password

# Authentication Method 2: API Key (recommended for security)
# ODOO_API_KEY=your_api_key_here

# Note: If both ODOO_PASSWORD and ODOO_API_KEY are set, API_KEY takes priority

# Optional Connection Settings
ODOO_TIMEOUT=30
ODOO_VERIFY_SSL=true

# Logging
LOG_LEVEL=INFO

# CORS Settings (for production, restrict these)
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Security Notes:
# - API Keys are more secure than passwords (can be revoked independently)
# - Generate API keys in Odoo: Settings > Users > Your User > Preferences > API Keys
# - Use HTTPS in production to protect credentials in transit
